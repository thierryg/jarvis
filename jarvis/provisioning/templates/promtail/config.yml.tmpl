# Ships the Jarvis log (log file + journald for the jarvis-* services) to Loki.
# Note: Grafana has deprecated Promtail in favor of Alloy; prefer log_shipper: alloy for new installs.
server:
  http_listen_address: 127.0.0.1
  http_listen_port: 9080
  grpc_listen_port: 0

positions:
  filename: /var/lib/promtail/positions.yaml

clients:
  - url: {{LOKI_URL}}
{{BASIC_AUTH}}
scrape_configs:
  - job_name: jarvis-file
    static_configs:
      - targets: [localhost]
        labels:
          job: jarvis
          host: {{HOSTNAME}}
          __path__: {{LOG_PATH}}/jarvis.log
    pipeline_stages:
      - regex:
          expression: '^(?P<ts>\S+ \S+) (?P<level>[A-Z]+)\s+\[(?P<process>[a-z]+)\] (?P<logger>\S+): (?P<msg>.*)$'
      - labels:
          level:
          process:
      - timestamp:
          source: ts
          format: '2006-01-02 15:04:05,000'
          location: Local

  - job_name: jarvis-journal
    journal:
      max_age: 12h
      labels:
        job: jarvis-journal
        host: {{HOSTNAME}}
    relabel_configs:
      - source_labels: [__journal__systemd_unit]
        regex: '(jarvis-.*|nginx)\.service'
        action: keep
      - source_labels: [__journal__systemd_unit]
        target_label: unit
