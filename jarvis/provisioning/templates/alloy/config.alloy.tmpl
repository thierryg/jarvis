// Grafana Alloy: Promtail's successor. Ships the Jarvis log (log file + journald) to Loki.

loki.write "default" {
  endpoint {
    url = "{{LOKI_URL}}"
{{BASIC_AUTH}}  }
  external_labels = { host = "{{HOSTNAME}}" }
}

local.file_match "jarvis" {
  path_targets = [{ "__path__" = "{{LOG_PATH}}/jarvis.log", "job" = "jarvis" }]
}

loki.source.file "jarvis" {
  targets    = local.file_match.jarvis.targets
  forward_to = [loki.process.jarvis.receiver]
}

loki.process "jarvis" {
  stage.regex {
    expression = "^(?P<ts>\\S+ \\S+) (?P<level>[A-Z]+)\\s+\\[(?P<process>[a-z]+)\\] (?P<logger>\\S+): (?P<msg>.*)$"
  }
  stage.labels {
    values = { level = "", process = "" }
  }
  forward_to = [loki.write.default.receiver]
}

loki.relabel "journal" {
  forward_to = []
  rule {
    source_labels = ["__journal__systemd_unit"]
    regex         = "(jarvis-.*|nginx)\\.service"
    action        = "keep"
  }
  rule {
    source_labels = ["__journal__systemd_unit"]
    target_label  = "unit"
  }
}

loki.source.journal "jarvis" {
  max_age       = "12h"
  relabel_rules = loki.relabel.journal.rules
  labels        = { job = "jarvis-journal" }
  forward_to    = [loki.write.default.receiver]
}
