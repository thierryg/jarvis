# {{ ansible_managed }} - /etc/ssh/sshd_config.d/01-jarvis-hardening.conf
Port {{ jarvis_ssh_port }}
# Authentication: public keys only, no root, no empty passwords, few attempts.
PermitRootLogin no
PubkeyAuthentication yes
PasswordAuthentication {{ 'yes' if jarvis_ssh_password_authentication | bool else 'no' }}
KbdInteractiveAuthentication no
PermitEmptyPasswords no
AuthenticationMethods publickey{{ ' password' if jarvis_ssh_password_authentication | bool else '' }}
MaxAuthTries 3
MaxSessions 4
MaxStartups 10:30:60
LoginGraceTime 30
{% if jarvis_ssh_allow_users | length > 0 %}
AllowUsers {{ jarvis_ssh_allow_users | join(' ') }}
{% endif %}
# No forwarding of any kind: this host is an appliance, not a bastion.
X11Forwarding no
AllowTcpForwarding no
AllowAgentForwarding no
AllowStreamLocalForwarding no
PermitTunnel no
GatewayPorts no
PermitUserEnvironment no
# Idle sessions are closed after 10 minutes.
ClientAliveInterval 300
ClientAliveCountMax 2
TCPKeepAlive no
# Legal banner before login; the MOTD (pam_motd, jarvis-motd) after login.
Banner /etc/issue.net
PrintMotd no
PrintLastLog yes
DebianBanner no
LogLevel VERBOSE
# Modern algorithms only (filtered against this OpenSSH build).
KexAlgorithms {{ ssh_kex | join(',') }}
Ciphers {{ ssh_ciphers | join(',') }}
MACs {{ ssh_macs | join(',') }}
HostKeyAlgorithms ssh-ed25519,ssh-ed25519-cert-v01@openssh.com,rsa-sha2-512,rsa-sha2-256
