# {{ ansible_managed }} - /etc/fail2ban/filter.d/jarvis-login.conf
# Matches nginx "combined" lines of POST /api/login answered 401 (bad credentials) or
# 429 (rate limit hit), e.g.:
#   192.0.2.10 - - [30/Sep/2026:11:00:00 +0200] "POST /api/login HTTP/2.0" 401 43 "-" "Mozilla/5.0"
# Test: fail2ban-regex /var/log/nginx/jarvis.access.log /etc/fail2ban/filter.d/jarvis-login.conf
[Definition]
# fail2ban removes the matched timestamp before applying the regex: the brackets may be empty.
failregex = ^<HOST> - \S+ \[[^\]]*\] "POST /api/login(?:\?\S*)? HTTP/[0-9.]+" (?:401|429) 
ignoreregex =
