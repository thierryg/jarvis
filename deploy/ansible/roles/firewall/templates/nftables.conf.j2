#!/usr/sbin/nft -f
# {{ ansible_managed }} - /etc/nftables.conf
# Inbound: default DROP. Allowed: loopback, replies, ICMP essentials, DHCP, mDNS (LAN),
# SSH from jarvis_admin_networks (rate-limited), HTTP/HTTPS from jarvis_lan_networks,
# node_exporter from the monitoring server. Outbound: allowed (camera RTSP, apt, NTP, MQTT).
# Only the "jarvis_filter" table is replaced on reload (fail2ban keeps its own table).
{% set lan4 = jarvis_lan_networks | reject('search', ':') | list %}
{% set lan6 = jarvis_lan_networks | select('search', ':') | list %}
{% set adm4 = jarvis_admin_networks | reject('search', ':') | list %}
{% set adm6 = jarvis_admin_networks | select('search', ':') | list %}
table inet jarvis_filter
delete table inet jarvis_filter

table inet jarvis_filter {
{% for name, nets, family in [('lan_v4', lan4, 'ipv4_addr'), ('lan_v6', lan6, 'ipv6_addr'), ('admin_v4', adm4, 'ipv4_addr'), ('admin_v6', adm6, 'ipv6_addr')] %}
    set {{ name }} {
        type {{ family }}
        flags interval
{% if nets %}
        elements = { {{ nets | join(', ') }} }
{% endif %}
    }
{% endfor %}

    # Per-source SSH rate limiting (dynamic sets, entries expire after one minute).
    set ssh_meter_v4 {
        type ipv4_addr
        flags dynamic
        timeout 1m
    }
    set ssh_meter_v6 {
        type ipv6_addr
        flags dynamic
        timeout 1m
    }

    chain input {
        type filter hook input priority filter; policy drop;

        iif "lo" accept
        ct state invalid counter drop
        ct state established,related accept

        # ICMP: errors and path MTU always, echo rate-limited; IPv6 neighbor discovery.
        ip protocol icmp icmp type { destination-unreachable, time-exceeded, parameter-problem } accept
        ip protocol icmp icmp type echo-request limit rate 10/second accept
        ip6 nexthdr ipv6-icmp icmpv6 type { destination-unreachable, packet-too-big, time-exceeded, parameter-problem, nd-router-advert, nd-neighbor-solicit, nd-neighbor-advert } accept
        ip6 nexthdr ipv6-icmp icmpv6 type echo-request limit rate 10/second accept

        # DHCP / DHCPv6 client replies.
        udp sport 67 udp dport 68 accept
        ip6 saddr fe80::/10 udp sport 547 udp dport 546 accept
{% if jarvis_mdns | bool %}

        # mDNS (<hostname>.local) from the LAN only.
        ip saddr @lan_v4 udp dport 5353 accept
        ip6 saddr @lan_v6 udp dport 5353 accept
{% endif %}

        # SSH from the administration networks, 15 new connections per minute per source.
        ip saddr @admin_v4 tcp dport {{ jarvis_ssh_port }} ct state new add @ssh_meter_v4 { ip saddr limit rate 15/minute } accept
        ip6 saddr @admin_v6 tcp dport {{ jarvis_ssh_port }} ct state new add @ssh_meter_v6 { ip6 saddr limit rate 15/minute } accept

        # Web UI (nginx): HTTP (redirect + ACME) and HTTPS, LAN only.
        ip saddr @lan_v4 tcp dport { 80, 443 } accept
        ip6 saddr @lan_v6 tcp dport { 80, 443 } accept
{% if jarvis_monitoring_server | length > 0 %}

        # Prometheus scrape of node_exporter from the monitoring server.
        {{ 'ip6' if ':' in jarvis_monitoring_server else 'ip' }} saddr {{ jarvis_monitoring_server }} tcp dport 9100 accept
{% endif %}
{% for rule in jarvis_firewall_extra_rules %}
        {{ rule }}
{% endfor %}

        # Everything else: counted (MOTD) and dropped, a few log lines per minute.
        limit rate 6/minute log prefix "jarvis-fw-drop: " level info
        counter drop comment "jarvis dropped"
    }

    chain forward {
        type filter hook forward priority filter; policy drop;
    }

    chain output {
        type filter hook output priority filter; policy accept;
    }
}
