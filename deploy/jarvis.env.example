# /etc/jarvis/jarvis.env — chmod 640, owner root:jarvis (systemd EnvironmentFile of every Jarvis unit).
#
# Two equivalent ways to provide a secret:
#  - plain variables referenced from config.yaml (secrets: camera_password: ${CAMERA_PASSWORD:-});
#  - JARVIS__<SECTION>__<KEY> variables, which override any key of config.yaml directly.
# A value set in the web UI (Settings > Secrets) takes precedence over both.
CAMERA_USER=jarvis
CAMERA_PASSWORD=change-me
# Only needed when wakeword.engine = porcupine (free key from console.picovoice.ai)
PICOVOICE_ACCESS_KEY=
# Examples of direct overrides:
# JARVIS__SECRETS__METRICS_TOKEN=a-long-random-token
# JARVIS__SECRETS__WEBHOOK_TOKEN=home-assistant-or-ntfy-token
# JARVIS__FACES__MATCH_THRESHOLD=0.5
