# File    : deploy/anubis/jarvis.env
# Purpose : Environment of the "jarvis" instance of anubis@.service (anti-bot proxy)
# Author  : Thierry Gayet <thierry.gayet@labworks.fr>
# Project : jarvis-home (version: jarvis/VERSION)
# Copyright (c) 2026 Thierry Gayet. SPDX-License-Identifier: 0BSD
# =============================================================================
# /etc/anubis/jarvis.env (root:root 0640, read by systemd itself, not by the service user).
# Anubis sits between nginx and the Jarvis API: nginx :443 -> Anubis 127.0.0.1:8923 -> API 127.0.0.1:8000.
# The signing key is NOT configured here: anubis@.service runs with DynamicUser=yes, so the
# root-only key /etc/anubis/jarvis.key is handed over as a systemd credential by the drop-in
# anubis@jarvis.service.d/10-jarvis.conf (ED25519_PRIVATE_KEY_HEX_FILE=%d/ed25519.key).
BIND=127.0.0.1:8923
BIND_NETWORK=tcp
TARGET=http://127.0.0.1:8000
POLICY_FNAME=/etc/anubis/jarvis.botPolicies.yaml
# Proof-of-work difficulty (leading zero nibbles): 4 is about one second on a phone.
DIFFICULTY=4
# Prometheus metrics of Anubis itself, local only (9090 is left to a local Prometheus).
METRICS_BIND=127.0.0.1:9091
METRICS_BIND_NETWORK=tcp
# robots.txt is served by nginx (Disallow: /).
SERVE_ROBOTS_TXT=false
COOKIE_SECURE=true
COOKIE_SAME_SITE=Strict
SLOG_LEVEL=INFO
# Only redirect back to Jarvis itself after a challenge (open-redirect protection); comma-separated.
# Rewritten by deploy/ansible from the certificate names.
REDIRECT_DOMAINS=jarvis.local
