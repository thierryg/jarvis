# /etc/systemd/system/jarvis-api.service
# Web API (FastAPI) behind nginx, listening on 127.0.0.1:8000. It has no hardware access at all:
# privileged actions go through the core's control socket, which only accepts a fixed allow-list
# of commands.
[Unit]
Description=Jarvis web API (behind nginx)
Documentation=file:///opt/jarvis/src/docs/SOFTWARE.md
After=network.target jarvis-core.service
PartOf=jarvis.target
# Give up after 5 failures within 10 minutes (avoids a restart loop on a persistent fault).
StartLimitIntervalSec=10min
StartLimitBurst=5

[Service]
# Per-service resource accounting (systemctl status, MOTD, jarvis resources): CPU time, memory,
# block I/O and network bytes of this unit's cgroup. Cheap on cgroup v2 (eBPF for IP counters).
CPUAccounting=yes
MemoryAccounting=yes
IOAccounting=yes
IPAccounting=yes
# Type=notify: the API sends READY=1 once it is actually serving requests.
Type=notify
NotifyAccess=main
TimeoutStartSec=60
TimeoutStopSec=15
User=jarvis
Group=jarvis
EnvironmentFile=/etc/jarvis/jarvis.env
Environment=JARVIS_CONFIG=/etc/jarvis/config.yaml PYTHONUNBUFFERED=1 HOME=/var/lib/jarvis
# Refuse to start on an invalid configuration (fails fast with a clear message in the journal).
ExecStartPre=/opt/jarvis/venv/bin/jarvis check-config api
ExecStart=/opt/jarvis/venv/bin/jarvis api
Restart=always
RestartSec=3
# mixed: the API itself finishes or cancels a running time-lapse export (FFmpeg child).
KillMode=mixed
UMask=0027

# Resources: the API must never starve the core (vision/voice) service.
CPUWeight=50
MemoryHigh=384M
MemoryMax=512M

# Maximum hardening: no devices, no capabilities, W^X enforced.
PrivateDevices=yes
DevicePolicy=closed
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/jarvis /run/jarvis /var/log/jarvis
# /var/log/jarvis: shared file log (rotated by the core)
LogsDirectory=jarvis
LogsDirectoryMode=0750
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryDenyWriteExecute=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=jarvis.target
