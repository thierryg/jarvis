# =============================================================================
# /etc/systemd/system/jarvis-monitoring.path
# Watches the desired monitoring state written by the (unprivileged) API and triggers a minimal
# root service to apply it (privilege separation: the API never runs anything as root itself).
[Unit]
Description=Jarvis: watch monitoring settings

[Path]
PathChanged=/var/lib/jarvis/monitoring/desired.json
Unit=jarvis-monitoring-apply.service

[Install]
WantedBy=jarvis.target
