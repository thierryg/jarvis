# =============================================================================
# /etc/systemd/system/jarvis.target
# Groups the Jarvis services: "systemctl start|stop|restart jarvis.target" acts on all of them.
[Unit]
Description=Jarvis: local smart gatekeeper (core + web API)
Documentation=file:///opt/jarvis/src/docs/SOFTWARE.md
Wants=jarvis-core.service jarvis-api.service nginx.service
After=network-online.target

[Install]
WantedBy=multi-user.target
