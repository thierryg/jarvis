# /etc/systemd/system/jarvis-cert-renew.timer
# Twice a day as recommended by Let's Encrypt; the renewal only happens within 30 days of expiry.
[Unit]
Description=Jarvis: TLS certificate renewal check

[Timer]
OnCalendar=*-*-* 04:17:00
OnCalendar=*-*-* 16:17:00
RandomizedDelaySec=1h
Persistent=true

[Install]
WantedBy=timers.target
